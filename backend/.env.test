# Test environment variables for AI backend
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=test_groq_api_key
AI_MODEL=llama3-70b-8192

# Optional: Fallback provider
FALLBACK_AI_BASE_URL=https://api.openai.com/v1
FALLBACK_AI_API_KEY=test_openai_api_key

# Timeout settings
AI_TIMEOUT=30

# Database configuration - using SQLite for tests
DATABASE_URL=sqlite:///./test_todo_app.db

# Authentication
AUTH_SECRET=test_auth_secret
JWT_SECRET=test_jwt_secret

# Application settings
NEXTAUTH_URL=http://localhost:3000